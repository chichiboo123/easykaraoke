{
  "name": "yeogi-isseo-karaoke",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && python3 -m http.server 5173 -d dist",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:deploy": "node scripts/check-deploy.mjs",
    "test:e2e": "node --test tests/e2e/*.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "playwright": "^1.63.0"
  },
  "engines": {
    "node": ">=20"
  }
}
